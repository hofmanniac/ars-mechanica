---
layout: null
---
[
  {% for mechanic in site.mechanics %}
    {
      "title": {{ mechanic.title | jsonify }},
      "slug": {{ mechanic.slug | jsonify }},
      "categories": {{ mechanic.categories | jsonify }},
      "tags": {{ mechanic.tags | jsonify }},
      "complexity": {{ mechanic.complexity | jsonify }},
      "content": {{ mechanic.content | strip_html | strip_newlines | truncatewords: 50 | jsonify }},
      "url": {{ mechanic.url | jsonify }},
      "aliases": {{ mechanic.aliases | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
